<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    app:cardBackgroundColor="@android:color/white"
    app:cardCornerRadius="12dp"
    app:cardElevation="2dp"
    app:strokeColor="#E0E0E0"
    app:strokeWidth="1dp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="14dp">

        <!-- Tên User -->
        <TextView
            android:id="@+id/tvUserName"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="#1A1A1A"
            android:textSize="17sp"
            android:textStyle="bold"
            app:layout_constraintEnd_toStartOf="@+id/tvUserRole"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            tools:text="Nguyễn Văn Tài" />

        <!-- Role (Nhãn quyền hạn) -->
        <TextView
            android:id="@+id/tvUserRole"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="#E3F2FD"
            android:paddingHorizontal="10dp"
            android:paddingVertical="3dp"
            android:textColor="#1565C0"
            android:textSize="12sp"
            android:textStyle="bold"
            app:layout_constraintBottom_toBottomOf="@+id/tvUserName"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@+id/tvUserName"
            tools:text="ADMIN" />

        <!-- Email -->
        <TextView
            android:id="@+id/tvUserEmail"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:drawablePadding="6dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="#555555"
            android:textSize="14sp"
            app:drawableStartCompat="@android:drawable/ic_dialog_email"
            app:drawableTint="#757575"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tvUserName"
            tools:text="nguyenvantai@example.com" />

        <!-- Số điện thoại -->
        <TextView
            android:id="@+id/tvUserPhone"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:drawablePadding="6dp"
            android:textColor="#555555"
            android:textSize="14sp"
            app:drawableStartCompat="@android:drawable/stat_sys_phone_call"
            app:drawableTint="#757575"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tvUserEmail"
            tools:text="0901 234 567" />

        <!-- Ngày sinh & Tuổi nằm chung một hàng -->
        <LinearLayout
            android:id="@+id/layoutDobAge"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tvUserPhone">

            <TextView
                android:id="@+id/tvUserDob"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:drawablePadding="6dp"
                android:textColor="#555555"
                android:textSize="14sp"
                app:drawableStartCompat="@android:drawable/ic_menu_my_calendar"
                app:drawableTint="#757575"
                tools:text="17/02/2005" />

            <TextView
                android:id="@+id/tvUserAge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:textColor="#555555"
                android:textSize="14sp"
                android:textStyle="bold"
                tools:text="• 21 tuổi" />
        </LinearLayout>

        <!-- Địa chỉ (cập nhật top constraint trỏ vào layoutDobAge) -->
        <TextView
            android:id="@+id/tvUserAddress"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:drawablePadding="6dp"
            android:ellipsize="end"
            android:maxLines="2"
            android:textColor="#555555"
            android:textSize="14sp"
            app:drawableStartCompat="@android:drawable/ic_dialog_map"
            app:drawableTint="#757575"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/layoutDobAge"
            tools:text="19 Nguyễn Hữu Thọ, Phường Tân Hưng, TP. Hồ Chí Minh" />

        <!-- Đường kẻ phân cách -->
        <View
            android:id="@+id/divider"
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_marginTop="10dp"
            android:background="#EEEEEE"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tvUserAddress" />

        <!-- Trạng thái nằm bên trái cùng dòng với Sửa / Xóa -->
        <TextView
            android:id="@+id/tvUserStatus"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:textSize="14sp"
            android:textStyle="bold"
            app:layout_constraintBottom_toBottomOf="@+id/layoutActions"
            app:layout_constraintEnd_toStartOf="@+id/layoutActions"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@+id/layoutActions"
            tools:text="• Normal" />

        <!-- Khu vực nút Sửa / Xóa bên phải -->
        <LinearLayout
            android:id="@+id/layoutActions"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:orientation="horizontal"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/divider">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnEditUser"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="38dp"
                android:layout_marginEnd="8dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:text="Sửa"
                android:textColor="#1976D2"
                app:icon="@android:drawable/ic_menu_edit"
                app:iconTint="#1976D2" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnDeleteUser"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="38dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:text="Xóa"
                android:textColor="#D32F2F"
                app:icon="@android:drawable/ic_menu_delete"
                app:iconTint="#D32F2F" />
        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>
</com.google.android.material.card.MaterialCardView>